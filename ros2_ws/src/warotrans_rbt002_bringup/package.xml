<?xml version="1.0"?>
<package format="3">
  <name>warotrans_rbt002_bringup</name>
  <version>0.1.0</version>
  <description>RBT-002 launch files and the single runtime parameter file (config/rbt002.yaml).</description>
  <maintainer email="dev@warotrans.local">WaroTrans Team</maintainer>
  <license>Proprietary</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>warotrans_rrc_lite</exec_depend>
  <exec_depend>warotrans_rbt002_hardware</exec_depend>
  <exec_depend>warotrans_rbt002_description</exec_depend>
  <exec_depend>warotrans_rbt002_control_gateway</exec_depend>
  <!-- sllidar_ros2 is built from source in ~/ros2_ws on the Pi (Slamtec repo); not a hard dependency so mock
       mode works without it. -->
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
