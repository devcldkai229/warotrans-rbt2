<?xml version="1.0"?>
<package format="3">
  <name>warotrans_rbt002_control_gateway</name>
  <version>0.1.0</version>
  <description>Mobile control UI gateway for RBT-002: FastAPI + WebSocket over rclpy (single control lease, deadman, 4-direction drive, calibration, telemetry).</description>
  <maintainer email="dev@warotrans.local">WaroTrans Team</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>warotrans_msgs</exec_depend>
  <exec_depend>warotrans_rbt002_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
